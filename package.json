{
  "name": "snacking_template",
  "version": "1.0.0",
  "description": "[![License: MIT](https://img.shields.io/badge/License-MIT-yellow.svg)](https://opensource.org/licenses/MIT) ![Version](https://img.shields.io/badge/version-1.0.0-blue.svg)",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:theming": "node scripts/check-theming.mjs",
    "build:tacos": "SNACK_ID=Ym1YiO4Ue5Fb5UXlxr06 vite build",
    "build:pizza": "SNACK_ID=PsobiuoeUzNmHnwGtaRu vite build",
    "build:pizzeria": "SNACK_ID=4L9THuI6hIAqKjjZUn4s vite build",
    "build:belly": "SNACK_ID=umaGD0nOIWwgpyy8Ta4h vite build",
    "build:all": "npm run build:tacos && npm run build:pizza && npm run build:pizzeria && npm run build:belly",
    "deploy:tacos": "npm run build:tacos && firebase deploy --only hosting:snacking-template",
    "deploy:pizza": "npm run build:pizza && firebase deploy --only hosting:o-bois-pizza",
    "deploy:pizzeria": "npm run build:pizzeria && firebase deploy --only hosting:pizzeriadelagare",
    "deploy:belly": "npm run build:belly && firebase deploy --only hosting:belly-smash-burger",
    "deploy:all": "npm run build:all && firebase deploy --only hosting",
    "migrate:snack-fields": "node functions/scripts/migrate-snack-fields.js",
    "migrate:snack-fields:apply": "node functions/scripts/migrate-snack-fields.js --apply",
    "migrate:pricing-supplements": "node functions/scripts/migrate-pricing-supplements.js",
    "migrate:pricing-supplements:apply": "node functions/scripts/migrate-pricing-supplements.js --apply",
    "migrate:product-tva": "node functions/scripts/migrate-product-tva.js",
    "migrate:product-tva:apply": "node functions/scripts/migrate-product-tva.js --apply",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage --project snacking-template",
    "seed": "node functions/seed-emulator.js",
    "test:e2e": "VITE_E2E_TESTING=true SNACK_ID=Ym1YiO4Ue5Fb5UXlxr06 firebase emulators:exec --only auth,firestore,functions,storage --project snacking-template \"node functions/seed-emulator.js && playwright test cart.spec.js commande.spec.js stock.spec.js reorder.spec.js radar.spec.js guest-checkout.spec.js\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:loyalty": "firebase emulators:exec --only firestore --project snacking-template \"node tests/integration/loyalty-harness.cjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project snacking-template \"vitest run --config vitest.rules.config.js\"",
    "test:refund": "firebase emulators:exec --only firestore --project snacking-template \"node tests/integration/refund-harness.cjs\"",
    "test:tunnel": "firebase emulators:exec --only firestore --project snacking-template \"node tests/integration/tunnel-harness.cjs\"",
    "test:r1": "firebase emulators:exec --only firestore --project snacking-template \"node tests/integration/r1-delivery-harness.cjs\"",
    "test:orphan": "firebase emulators:exec --only firestore --project snacking-template \"node tests/integration/orphan-charge-harness.cjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sulayman74/snacking_template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Sulayman74/snacking_template/issues"
  },
  "homepage": "https://github.com/Sulayman74/snacking_template#readme",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.27",
    "firebase-functions-test": "^3.5.0",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "firebase": "^12.11.0",
    "firebase-functions": "^7.2.3",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.3.0",
    "lit": "^3.3.3",
    "lucide": "^1.18.0",
    "qrcode": "^1.5.4"
  }
}

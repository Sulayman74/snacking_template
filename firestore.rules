rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSnackAdmin(targetSnackId) {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && authUser.data.role == 'admin' && authUser.data.snackId == targetSnackId;
    }

    function isSuperAdmin() {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && authUser.data.role == 'superadmin';
    }

    function isAnyAdmin() {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && (authUser.data.role == 'admin' || authUser.data.role == 'superadmin');
    }

    // 🚚 LIVREUR : rôle stocké sur le doc users/{uid} (cohérent avec admin/superadmin).
    function isDriver(targetSnackId) {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && authUser.data.role == 'livreur' && authUser.data.snackId == targetSnackId;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /snacks/{snackId} {
      allow read: if true;
      allow write: if isSnackAdmin(snackId) || isSuperAdmin();
    }

    match /users/{userId} {
      // Lecture UNITAIRE (get par uid) : le client lit son doc ; un admin peut lire
      // un doc précis (nécessaire au scanner fidélité — les clients sont globaux,
      // sans snackId, et cumulent des points multi-snack via pointsBySnack).
      allow get: if isOwner(userId) || isAnyAdmin();

      // Lecture en LISTE (query) : réservée au snack propriétaire des docs ciblés
      // (anti-énumération RGPD cross-tenant). Seuls les docs livreur/admin portent
      // un snackId ; les fiches clients (PII) ne sont donc plus énumérables.
      allow list: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();

      // Mise à jour : un admin peut créditer la fidélité (pointsBySnack) de n'importe
      // quel client, MAIS ne peut JAMAIS toucher 'role' ni 'snackId'
      // (anti-élévation de privilège). Le client ne touche que fcmToken/lastOrderDate.
      allow update: if isSuperAdmin()
                    || (
                         isAnyAdmin()
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'snackId'])
                       )
                    || (
                         isOwner(userId)
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'lastOrderDate'])
                       );

      // 🛡️ Création : le client crée son propre doc en rôle 'client', sans points
      // de fidélité préchargés (pointsBySnack vide). Conforme à src/auth.js.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'client'
                    && request.resource.data.pointsBySnack.size() == 0;
    }

    match /produits/{produitId} {
      allow read: if true;
      allow write: if isSnackAdmin(request.resource.data.snackId)
                   || (resource != null && isSnackAdmin(resource.data.snackId))
                   || isSuperAdmin();
    }

		match /commandes/{commandeId} {
      // 1. Lecture : Le client voit sa commande, un admin voit tout,
      //    et le livreur du snack voit les commandes de SON snack (pour récupérer les courses).
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isSnackAdmin(resource.data.snackId) ||
        isSuperAdmin() ||
        isDriver(resource.data.snackId)
      );

      // 2. Création : EXCLUSIVEMENT côté serveur (finalizeOrder, Admin SDK) après
      //    validation du paiement Stripe. Aucune création directe par le client
      //    (sinon : commande forgée 'payé' contournant finalizeOrder). Cf. functions/index.js:748.
      allow create: if false;

      // 3. Modification (Update) :
      // - Le client peut modifier (ex: pour le bouton "Je suis arrivé")
      // - L'admin du snack peut modifier (ex: pour changer le statut en cuisine)
      // - Le SuperAdmin peut tout faire
      // - Le LIVREUR du snack peut UNIQUEMENT toucher les champs de livraison
      //   (livreur/livreurId/statut) d'une commande en mode 'delivery', et
      //   seulement si la course n'est pas déjà prise par un autre livreur.
      allow update: if isAuthenticated() && (
        // Le client (propriétaire) ne peut QUE déclencher "Je suis arrivé" :
        // statut → 'nouvelle' + dateArriveeClient. Il ne peut PAS falsifier
        // total/paiement/snackId. Cf. src/tracking.js:104.
        (
          isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'dateArriveeClient'])
          && request.resource.data.statut == 'nouvelle'
        ) ||
        isSnackAdmin(resource.data.snackId) ||
        isSuperAdmin() ||
        (
          isDriver(resource.data.snackId)
          && resource.data.mode == 'delivery'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['livreur', 'livreurId', 'statut'])
          && request.resource.data.statut in ['prete', 'en_livraison', 'livree']
          && (resource.data.livreurId == null || resource.data.livreurId == request.auth.uid)
        )
      );

      // 4. Suppression : On peut autoriser le SuperAdmin à faire le ménage si besoin
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // 🚀 MARKETING : RÈGLES POUR LES CAMPAGNES PUSH (NOUVEAU)
    // =========================================================
    match /campagnes_push/{campagneId} {
      // Seuls l'Admin du snack concerné ou le SuperAdmin peuvent voir les campagnes
      allow read: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();

      // Pour créer, on vérifie que le snackId envoyé correspond bien au snack de l'Admin
      allow create: if isSnackAdmin(request.resource.data.snackId) || isSuperAdmin();

      // Pour modifier/supprimer
      allow update, delete: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();
    }

    // 🛑 LE VIDEUR : Rejette tout ce qui n'est pas explicitement autorisé au-dessus
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

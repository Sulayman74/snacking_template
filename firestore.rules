rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSnackAdmin(targetSnackId) {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && authUser.data.role == 'admin' && authUser.data.snackId == targetSnackId;
    }

    function isSuperAdmin() {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && authUser.data.role == 'superadmin';
    }

    function isAnyAdmin() {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && (authUser.data.role == 'admin' || authUser.data.role == 'superadmin');
    }

    // 🚚 LIVREUR : rôle stocké sur le doc users/{uid} (cohérent avec admin/superadmin).
    function isDriver(targetSnackId) {
      let authUser = getAuthUser();
      return isAuthenticated() && authUser != null && authUser.data.role == 'livreur' && authUser.data.snackId == targetSnackId;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /snacks/{snackId} {
      allow read: if true;
      // Création/suppression d'un snack : superadmin uniquement.
      allow create, delete: if isSuperAdmin();
      // Update : superadmin (tout) OU admin du snack mais SANS toucher les champs
      // sensibles — gérés exclusivement par les Cloud Functions (Admin SDK) et le
      // superadmin (onboarding Stripe, statut Connect, suspension SaaS).
      allow update: if isSuperAdmin()
                    || (
                         isSnackAdmin(snackId)
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                              'stripeAccountId', 'stripeSubscriptionId', 'maintenanceMode',
                              'stripeChargesEnabled', 'stripeDetailsSubmitted', 'stripePayoutsEnabled'
                            ])
                       );

      // 📊 STATS UPSELL : compteurs shown/accepted/revenue par produit.
      // Lecture réservée à l'admin du snack (ou superadmin) pour la vue
      // "Performance Upsell". Écriture EXCLUSIVEMENT côté serveur (Admin SDK
      // bypass les règles) → un client ne fabrique jamais ses propres stats.
      // NB: les règles ne cascadent pas vers les sous-collections, d'où ce match imbriqué.
      match /upsellStats/{productId} {
        allow read: if isSnackAdmin(snackId) || isSuperAdmin();
        allow write: if false;
      }
    }

    match /users/{userId} {
      // Lecture UNITAIRE (get par uid) : le client lit son doc ; un admin peut lire
      // un doc précis (nécessaire au scanner fidélité — les clients sont globaux,
      // sans snackId, et cumulent des points multi-snack via pointsBySnack).
      allow get: if isOwner(userId) || isAnyAdmin();

      // Lecture en LISTE (query) : réservée au snack propriétaire des docs ciblés
      // (anti-énumération RGPD cross-tenant). Seuls les docs livreur/admin portent
      // un snackId ; les fiches clients (PII) ne sont donc plus énumérables.
      allow list: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();

      // Mise à jour : un admin peut éditer les fiches users de SON snack uniquement
      // (livreurs/admins portant resource.data.snackId == son snack), MAIS jamais
      // 'role'/'snackId' (anti-élévation) NI les champs de fidélité (points/
      // pointsBySnack/loyaltyLastScan, écrits côté serveur). isSnackAdmin (et non
      // isAnyAdmin) ferme le cross-tenant ; les fiches client (sans snackId) ne sont
      // éditables que par leur propriétaire (branche isOwner) ou le superadmin.
      allow update: if isSuperAdmin()
                    || (
                         isSnackAdmin(resource.data.snackId)
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                              'role', 'snackId', 'points', 'pointsBySnack', 'loyaltyLastScan',
                              'loyaltyLastCredit', 'rewardsAvailable', 'rewardsRedeemed'
                            ])
                       )
                    || (
                         // Le client ne touche que ses champs non sensibles : token push,
                         // date de dernière commande, et sa liste de favoris (raccourci
                         // d'UI non financier — le prix réel est recalculé par finalizeOrder).
                         isOwner(userId)
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'lastOrderDate', 'favorites'])
                         // Plafond anti-bloat : la liste de favoris reste raisonnable.
                         && (
                              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['favorites'])
                              || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 50)
                            )
                       );

      // 🛡️ Création : le client crée son propre doc en rôle 'client', avec une carte
      // de fidélité VIDE et SANS pouvoir forger un solde (`points`), s'auto-attribuer
      // un tenant (`snackId`) ni un `loyaltyLastScan`. `pointsBySnack == {}` refuse
      // proprement le cas où le champ est absent (null == {} → false). Cf. src/auth.js.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'client'
                    && request.resource.data.pointsBySnack == {}
                    && !request.resource.data.keys().hasAny(['points', 'snackId', 'loyaltyLastScan', 'loyaltyLastCredit', 'rewardsAvailable', 'rewardsRedeemed']);
    }

    match /produits/{produitId} {
      allow read: if true;
      // Création : uniquement dans SON snack. Update : propriétaire requis ET
      // snackId IMMUABLE (sinon un admin s'approprie le produit d'un autre snack
      // en changeant snackId — l'ancienne clause testait le nouveau snackId).
      allow create: if isSnackAdmin(request.resource.data.snackId) || isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (
                         isSnackAdmin(resource.data.snackId)
                         && request.resource.data.snackId == resource.data.snackId
                       );
      allow delete: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();
    }

		match /commandes/{commandeId} {
      // 1. Lecture : Le client voit sa commande, un admin voit tout,
      //    et le livreur du snack voit les commandes de SON snack (pour récupérer les courses).
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isSnackAdmin(resource.data.snackId) ||
        isSuperAdmin() ||
        isDriver(resource.data.snackId)
      );

      // 2. Création : EXCLUSIVEMENT côté serveur (finalizeOrder, Admin SDK) après
      //    validation du paiement Stripe. Aucune création directe par le client
      //    (sinon : commande forgée 'payé' contournant finalizeOrder). Cf. functions/index.js:748.
      allow create: if false;

      // 3. Modification (Update) :
      // - Le client peut modifier (ex: pour le bouton "Je suis arrivé")
      // - L'admin du snack peut modifier (ex: pour changer le statut en cuisine)
      // - Le SuperAdmin peut tout faire
      // - Le LIVREUR du snack peut UNIQUEMENT toucher les champs de livraison
      //   (livreur/livreurId/statut) d'une commande en mode 'delivery', et
      //   seulement si la course n'est pas déjà prise par un autre livreur.
      allow update: if isAuthenticated() && (
        // Le client (propriétaire) ne peut QUE déclencher "Je suis arrivé" :
        // 'en_attente_client' → 'nouvelle' + dateArriveeClient. Il ne peut PAS
        // falsifier total/paiement/snackId, NI renvoyer en file une commande
        // déjà avancée (prete/en_livraison/livree). Cf. src/tracking.js:104.
        (
          isOwner(resource.data.userId)
          && resource.data.statut == 'en_attente_client'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'dateArriveeClient'])
          && request.resource.data.statut == 'nouvelle'
        ) ||
        // L'admin du snack gère sa commande (statut cuisine, paiement, livreur…)
        // MAIS ne peut PAS muter les champs financiers de compta : ils naissent
        // dans finalizeOrder/refundOrder (Admin SDK, hors rules) et doivent rester
        // une source de vérité serveur (LOT A). Le superadmin garde le plein accès.
        (
          isSnackAdmin(resource.data.snackId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'commission', 'stripeFee', 'stripeNet', 'stripeFeePending', 'tvaBreakdown', 'refund'
             ])
        ) ||
        isSuperAdmin() ||
        (
          isDriver(resource.data.snackId)
          && resource.data.mode == 'delivery'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['livreur', 'livreurId', 'statut'])
          && request.resource.data.statut in ['prete', 'en_livraison', 'livree']
          && (resource.data.livreurId == null || resource.data.livreurId == request.auth.uid)
        )
      );

      // 4. Suppression : On peut autoriser le SuperAdmin à faire le ménage si besoin
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // 🚀 MARKETING : RÈGLES POUR LES CAMPAGNES PUSH (NOUVEAU)
    // =========================================================
    match /campagnes_push/{campagneId} {
      // Seuls l'Admin du snack concerné ou le SuperAdmin peuvent voir les campagnes
      allow read: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();

      // Création EXCLUSIVEMENT côté serveur (Cloud Functions schedulePushCampaign /
      // pushFlashOffer, Admin SDK). Ferme le contournement du quota mensuel par
      // écriture client directe (le quota est enforcé dans la CF).
      allow create: if false;

      // Pour modifier/supprimer
      allow update, delete: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();
    }

    // 🎟️ FIDÉLITÉ : journal d'audit des menus offerts consommés (LOT F2).
    // Écriture EXCLUSIVEMENT côté serveur (redeemLoyaltyReward, Admin SDK → bypass).
    // Lecture réservée à l'admin du snack (réconciliation compta) ou superadmin.
    match /loyaltyRewards/{rewardId} {
      allow read: if isSnackAdmin(resource.data.snackId) || isSuperAdmin();
      allow write: if false;
    }

    // 🛑 LE VIDEUR : Rejette tout ce qui n'est pas explicitement autorisé au-dessus
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

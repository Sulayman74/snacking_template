# Secrets des Cloud Functions pour l'ÉMULATEUR et les harnais de test.
# Copier en functions/.secret.local (gitignoré). Clés TEST uniquement (sk_test_…).
# En production, ces valeurs vivent dans Secret Manager :
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# Ne JAMAIS les mettre dans functions/.env : ce fichier est déployé avec le code.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
